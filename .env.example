APP_NAME=Nexora AI
APP_ENV=development
APP_SECRET=change-this-before-production
DATABASE_URL=sqlite:///./nexora.db

# DEMO=true seeds sample HVAC leads and allows mock connectors.
# LIVE requires DEMO_MODE=false and clean bootstrap credentials below.
DEMO_MODE=true
DEMO_EMAIL=admin@nexora.local
DEMO_PASSWORD=nexora-demo
BOOTSTRAP_BUSINESS_NAME=Nexora HVAC
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

AI_PROVIDER=local
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=local
AI_MODEL=local-model
DEFAULT_TIMEZONE=America/New_York

# Required before saving real OAuth/API credentials.
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/connectors/google/callback

# Optional fallbacks. Dashboard credentials are encrypted per workspace.
HUBSPOT_PRIVATE_APP_TOKEN=
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_SECRET=
INTAKE_API_KEY=

AUTOMATION_ENABLED=true
AUTOMATION_POLL_SECONDS=30
GMAIL_POLL_SECONDS=60
SESSION_MAX_AGE_SECONDS=28800
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
